CONTROL_PLANE_URL=https://api.veloflux.io
EDGE_CLUSTER=clients-pro
EDGE_NODE_NAME=vercel-edge-primary

# One-time enrollment token generated by your VeloFlux account.
EDGE_TOKEN=

# Long random secret unique to this logical edge. Keep it only in provider secrets.
EDGE_NODE_TOKEN=

# Optional after the first registration. Managed runtimes can reattach without it.
EDGE_NODE_ID=
